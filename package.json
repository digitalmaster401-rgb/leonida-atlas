{
  "name": "leonida-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LEONIDA ATLAS \u2014 gu\u00eda independiente de fans de Grand Theft Auto VI en espa\u00f1ol de M\u00e9xico.",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:data && tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "validate:data": "vitest run tests/data.test.ts",
    "images": "python3 scripts/fetch_official_images.py",
    "audit:legacy": "node scripts/audit-legacy.mjs",
    "zip": "python3 scripts/make_zip.py",
    "serve:dist": "node scripts/serve-dist.mjs",
    "icons": "node scripts/make-icons.mjs",
    "intel:run": "tsx scripts/intel/run.ts",
    "intel:migrate": "tsx scripts/intel/migrate.ts",
    "intel:dry": "tsx scripts/intel/run.ts --dry-run"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "latest",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}